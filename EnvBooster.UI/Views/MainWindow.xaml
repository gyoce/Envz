<Window x:Class="EnvBooster.UI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:EnvBooster.UI"
  mc:Ignorable="d"
  Title="MainWindow" Width="1280" Height="480" 
  ResizeMode="NoResize"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterScreen">

  <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.25" Direction="270"/>
    </Border.Effect>

    <Grid Background="{StaticResource BackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="53"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Grid Grid.Row="0" Grid.ColumnSpan="2" MouseLeftButtonDown="TitleBarMouseLeftButtonDown" Background="{StaticResource SidebarBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="5, 5, 0, 0" Style="{StaticResource H1}" Text="EnvBooster"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0, 0, 0, 5">
          <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButtonClick">
            <Image Margin="0, 10, 0, 0" Source="{StaticResource IconUnderscoreBlack}" Width="16" Height="16"/>
          </Button>

          <Button Style="{StaticResource TitleBarButton}" Click="CloseButtonClick">
            <Image Source="{StaticResource IconCrossBlack}" Width="16" Height="16"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Content -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="192"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{StaticResource SidebarBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Button x:Name="ButtonHome" Grid.Row="0" Style="{StaticResource PrimaryButton}" Margin="10, 10, 10, 0" Height="40" Tag="active">
            <TextBlock Text="Home" Style="{StaticResource Body}"/>
          </Button>
          <Button x:Name="ButtonCreateEnvironment" Grid.Row="1" Style="{StaticResource PrimaryButton}" Margin="10, 10, 10, 0" Height="40">
            <TextBlock Text="Create environment" Style="{StaticResource Body}"/>
          </Button>
          <Button x:Name="ButtonSettings" Grid.Row="2" Style="{StaticResource PrimaryButton}" Margin="10, 10, 10, 0" Height="40">
            <TextBlock Text="Settings" Style="{StaticResource Body}"/>
          </Button>
        </Grid>
        
        <!-- Main content -->
        <Button Grid.Column="1">Create env</Button>
      </Grid>
    </Grid>
  </Border>
</Window>