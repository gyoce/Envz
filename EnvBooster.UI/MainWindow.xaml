<Window x:Class="EnvBooster.UI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:EnvBooster.UI"
  mc:Ignorable="d"
  Title="MainWindow" Width="1280" Height="480" 
  ResizeMode="NoResize"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterScreen">

  <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.25" Direction="270"/>
    </Border.Effect>

    <Grid Background="{StaticResource BackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="53"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Grid Grid.Row="0" Grid.ColumnSpan="2" MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="5, 5, 0, 0" Style="{StaticResource H1}" Text="EnvBooster"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0, 0, 0, 5">
          <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButtonClick">
            <Image Margin="0, 10, 0, 0" Source="{StaticResource IconUnderscoreBlack}" Width="16" Height="16"/>
          </Button>

          <Button Style="{StaticResource TitleBarButton}" Click="CloseButtonClick">
            <Image Source="{StaticResource IconCrossBlack}" Width="16" Height="16"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- First Content -->
      <Grid Grid.Row="1" Margin="0, 10, 0, 10" Grid.ColumnSpan="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Margin="0, 0, 10, 0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" FontSize="16">
          <TextBlock Text="+ New environment" Style="{StaticResource H4}" Foreground="White"/>
        </Button>
      </Grid>


      <!-- Second Content -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <local:EnvironmentUserControl Margin="10"/>
          <local:EnvironmentUserControl Margin="10"/>
          <local:EnvironmentUserControl Margin="10"/>
          <local:EnvironmentUserControl Margin="10"/>
          <local:EnvironmentUserControl Margin="10"/>
          <local:EnvironmentUserControl Margin="10"/>
          <local:EnvironmentUserControl Margin="10"/>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>