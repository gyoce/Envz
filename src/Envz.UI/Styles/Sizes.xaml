<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:Double x:Key="AppWidth">1280</sys:Double>
  <sys:Double x:Key="AppHeight">540</sys:Double>

  <sys:Double x:Key="AppDialogWidth">960</sys:Double>
  <sys:Double x:Key="AppDialogHeight">425</sys:Double>

  <sys:Double x:Key="PageWidth">1090</sys:Double> <!-- PageWidth = AppWidth - SideBarWidth -->
  <sys:Double x:Key="PageHeight">490</sys:Double> <!-- PageHeight = AppHeight - TitleBarHeight -->

  <sys:Double x:Key="SubPageWidth">1090</sys:Double> <!-- SubPageWidth = PageWidth -->
  <sys:Double x:Key="SubPageHeight">450</sys:Double> <!-- SubPageHeight = PageHeight - BreadcrumbHeight -->

  <sys:Double x:Key="TitleBarHeight">50</sys:Double>

  <sys:Double x:Key="SideBarWidth">190</sys:Double>

  <sys:Double x:Key="BreadcrumbHeight">40</sys:Double>
  <sys:Double x:Key="BreadcrumbWidth">1090</sys:Double>

  <sys:Double x:Key="EnvironmentListItemWidth">330</sys:Double>
  <sys:Double x:Key="EnvironmentListItemHeight">170</sys:Double>

  <sys:Double x:Key="ApplicationListItemWidth">1030</sys:Double>
  <sys:Double x:Key="ApplicationListItemHeight">50</sys:Double>

  <sys:Double x:Key="DialogApplicationListItemWidth">920</sys:Double>
  <sys:Double x:Key="DialogApplicationListItemHeight">50</sys:Double>

  <sys:Double x:Key="EnvironmentApplicationListItemWidth">1030</sys:Double>
  <sys:Double x:Key="EnvironmentApplicationListItemHeight">50</sys:Double>

  <sys:Double x:Key="TextInputHeight">35</sys:Double>

</ResourceDictionary>