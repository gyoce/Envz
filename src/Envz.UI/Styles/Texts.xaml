<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="PoppinsRegular">
    pack://application:,,,/Assets/Fonts/#Poppins
  </FontFamily>
  <FontFamily x:Key="PoppinsBold">
    pack://application:,,,/Assets/Fonts/#Poppins Bold
  </FontFamily>

  <Style x:Key="TextBase" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PoppinsRegular}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>

  <Style x:Key="TextH1" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontFamily" Value="{StaticResource PoppinsBold}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="44" />
  </Style>

  <Style x:Key="TextH2" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="34" />
  </Style>

  <Style x:Key="TextH3" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <Style x:Key="TextH4" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <Style x:Key="TextBody" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <Style x:Key="TextBodySmall" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="LineHeight" Value="18" />
  </Style>

  <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

</ResourceDictionary>
