<Window 
  x:Class="Envz.UI.Views.Dialogs.SelectApplicationDialog" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="clr-namespace:Envz.UI.Views.UserControls.Controls"
  xmlns:vm="clr-namespace:Envz.UI.ViewModels.Dialogs"
  mc:Ignorable="d" 
  Title="SelectApplicationDialog" 
  ResizeMode="NoResize" 
  WindowStyle="None" 
  AllowsTransparency="True" 
  WindowStartupLocation="CenterOwner"
  d:DataContext="{d:DesignInstance Type=vm:SelectApplicationDialogViewModel}"
  Width="{StaticResource AppDialogWidth}" 
  Height="{StaticResource AppDialogHeight}">

  <Border Background="{StaticResource BgPrimaryBrush}" BorderBrush="{StaticResource NeutralBrush}" BorderThickness="2" CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.25" Direction="270" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Select an application" Style="{StaticResource TextH2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" VerticalAlignment="Stretch">
          <Button Style="{StaticResource TitleBarButton}" Click="CloseButtonClick">
            <Image Source="{StaticResource IconCrossBlack}" Width="16" Height="16" />
          </Button>
        </Grid>
      </Grid>

      <!-- Content -->
      <Grid Grid.Row="1">

      </Grid>

      <StackPanel Grid.Row="2" Margin="0 0 0 5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <controls:ButtonText ButtonStyle="{StaticResource SecondaryButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Cancel" Command="{Binding CancelCommand}" Width="120" />
        <controls:ButtonText Margin="10 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select" Command="{Binding SelectApplicationCommand}" Width="120" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Border>

</Window>