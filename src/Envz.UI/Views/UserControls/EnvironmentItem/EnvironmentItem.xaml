<UserControl 
  x:Class="Envz.UI.Views.UserControls.EnvironmentItem.EnvironmentItem" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:ei="clr-namespace:Envz.UI.Views.UserControls.EnvironmentItem"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=ei:EnvironmentItemViewModel}"
  Width="{StaticResource EnvironmentListItemWidth}" 
  Height="{StaticResource EnvironmentListItemHeight}">

  <Border Background="{StaticResource BgSecondaryBrush}" 
          BorderBrush="{StaticResource NeutralFocusBrush}" 
          BorderThickness="1" 
          CornerRadius="3">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" 
                   Text="{Binding Environment.Name, FallbackValue=EnvironmentName}" 
                   Style="{StaticResource TextH4}" 
                   VerticalAlignment="Center" 
                   Margin="10 0 5 0" />
        <ctrls:ButtonImage Grid.Column="1" 
                           Source="{StaticResource IconPlayWhite}" 
                           ButtonStyle="{StaticResource PrimaryButtonSmall}"
                           Margin="0 5 10 5" />
      </Grid>

      <TextBlock Grid.Row="1" 
                 Style="{StaticResource TextCaption}" 
                 Text="{Binding NumberOfApplicationsText, FallbackValue='X applications'}" 
                 Margin="10 5 10 5" />

      <Grid Grid.Row="2" Margin="10 0 10 5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ctrls:ButtonTextImage Grid.Column="0"
                               Margin="0 0 10 0"
                               ButtonStyle="{StaticResource PrimaryButtonSmall}"
                               TextStyle="{StaticResource TextBodySmall}"
                               Text="{loc:Translate Global_Edit}"
                               Source="{StaticResource IconSettingsWhite}"
                               Command="{Binding EditEnvironmentCommand}" />
        <ctrls:ButtonTextImage Grid.Column="1"
                               Margin="0 0 10 0"
                               ButtonStyle="{StaticResource PrimaryButtonSmall}"
                               TextStyle="{StaticResource TextBodySmall}"
                               Text="{loc:Translate Global_Duplicate}"
                               Source="{StaticResource IconDuplicateWhite}" />
        <ctrls:ButtonImage Grid.Column="2"
                           ButtonStyle="{StaticResource PrimaryButtonSmall}"
                           Source="{StaticResource IconTrashWhite}" />
      </Grid>

    </Grid>
  </Border>

</UserControl>