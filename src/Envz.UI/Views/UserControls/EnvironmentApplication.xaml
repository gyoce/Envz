<UserControl
  x:Class="Envz.UI.Views.UserControls.EnvironmentApplication"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:vm="clr-namespace:Envz.UI.ViewModels.UserControls"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:EnvironmentApplicationViewModel}"
  Width="{StaticResource EnvironmentApplicationListItemWidth}"
  Height="{StaticResource EnvironmentApplicationListItemHeight}">

  <Border Background="{StaticResource BgSecondaryBrush}" 
          BorderBrush="{StaticResource NeutralFocusBrush}" 
          BorderThickness="1" 
          CornerRadius="3">
    <Grid Margin="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" />

      <Grid Grid.Column="1" Margin="5 0 0 0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
          <TextBlock Text="{Binding Application.Name, FallbackValue=Application}" 
                     Style="{StaticResource TextBody}" 
                     VerticalAlignment="Center" 
                     Margin="0 0 20 0" />
          <TextBlock Text="{Binding Application.Path, FallbackValue=C:\\path\\to\\application.exe}" 
                     Style="{StaticResource TextCaption}" 
                     Foreground="{StaticResource ForegroundMutedBrush}" 
                     TextTrimming="CharacterEllipsis" 
                     VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="0" Grid.Row="1"
                CornerRadius="3" 
                Background="{StaticResource SidebarBrush}" 
                VerticalAlignment="Center">
          <TextBlock Text="{Binding ParameterText}" 
                     Style="{StaticResource TextCaption}" 
                     Foreground="{StaticResource ForegroundMutedBrush}" />
        </Border>
      </Grid>
    </Grid>
  </Border>

</UserControl>
