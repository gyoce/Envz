<UserControl
  x:Class="Envz.UI.Views.UserControls.ToolItem.ToolItem"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ai="clr-namespace:Envz.UI.Views.UserControls.ToolItem"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=ai:ToolItemViewModel}"
  d:DesignWidth="{StaticResource ToolListItemWidth}"
  d:DesignHeight="{StaticResource ToolListItemHeight}">

  <Border Style="{StaticResource ToolBorderStyle}">
    <Grid Margin="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="40" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
        <TextBlock Text="{Binding Tool.Name}"
                   d:Text="Tool"
                   Style="{StaticResource TextBody}" />
        <TextBlock Text="{Binding Tool.Path}"
                   d:Text="C:\path\to\tool.exe"
                   Style="{StaticResource TextCaption}" 
                   Foreground="{StaticResource ForegroundMutedBrush}" 
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <ctrls:ButtonImage Grid.Column="2" 
                         Source="{StaticResource IconTrashBlack}" 
                         ButtonStyle="{StaticResource TransparentBlackButton}"
                         ImageHeight="32"
                         Command="{Binding DeleteCommand}" 
                         Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
  </Border>

</UserControl>
