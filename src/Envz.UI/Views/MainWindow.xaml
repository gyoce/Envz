<Window 
  x:Class="Envz.UI.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="clr-namespace:Envz.UI.Views"
  xmlns:bc="clr-namespace:Envz.UI.Views.UserControls.Breadcrumb"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d" 
  d:DataContext="{d:DesignInstance Type=views:MainWindowViewModel}"
  Title="Envz" 
  Width="{StaticResource AppWidth}" 
  Height="{StaticResource AppHeight}" 
  ResizeMode="NoResize"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterScreen">

  <Border Background="{StaticResource BgPrimaryBrush}" 
          BorderBrush="{StaticResource NeutralBrush}" 
          BorderThickness="2" 
          CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect Color="#000000" 
                        BlurRadius="15" 
                        ShadowDepth="2" 
                        Opacity="0.25" 
                        Direction="270" />
    </Border.Effect>

    <Grid>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Height="{StaticResource TitleBarHeight}"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown" 
              Background="{StaticResource SidebarBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" 
                     Margin="10 5 0 0" 
                     Style="{StaticResource TextH1}" 
                     Text="Envz" />

          <Grid Grid.Column="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Style="{StaticResource TitleBarButton}" 
                    Click="MinimizeButtonClick">
              <Image Margin="0, 10, 0, 0" 
                     Source="{StaticResource IconUnderscoreBlack}" 
                     Width="16" Height="16" />
            </Button>

            <Button Grid.Column="1" 
                    Style="{StaticResource TitleBarButton}" 
                    Click="CloseButtonClick">
              <Image Source="{StaticResource IconCrossBlack}" 
                     Width="16" Height="16" />
            </Button>
          </Grid>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" 
                      Width="{StaticResource SideBarWidth}"
                      Background="{StaticResource SidebarBrush}">
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="{loc:Translate Global_Home}" 
                         Command="{Binding ShowHomePageCommand}" 
                         IsChecked="True" />
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="{loc:Translate Global_Environments}" 
                         Command="{Binding ShowEnvironmentsPageCommand}" />
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="{loc:Translate Global_Applications}" 
                         Command="{Binding ShowApplicationsPageCommand}" />
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="{loc:Translate Global_Settings}" 
                         Command="{Binding ShowSettingsPageCommand}" />
          </StackPanel>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <bc:Breadcrumb Grid.Row="0" Items="{Binding BreadcrumbItems}" />
            <ContentControl Grid.Row="1" x:Name="PageHost" />
          </Grid>
        </Grid>
      </Grid>

      <Border Background="#80000000" 
              Panel.ZIndex="10" 
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}" 
              d:Visibility="Collapsed" />
    </Grid>
  </Border>

</Window>