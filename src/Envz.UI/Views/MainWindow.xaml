<Window 
  x:Class="Envz.UI.Views.MainWindow" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:vEnvironments="clr-namespace:Envz.UI.Views.Pages.Environments" 
  xmlns:vmEnvironments="clr-namespace:Envz.UI.ViewModels.Pages.Environments" 
  xmlns:vApplications="clr-namespace:Envz.UI.Views.Pages.Applications" 
  xmlns:vmApplications="clr-namespace:Envz.UI.ViewModels.Pages.Applications"
  xmlns:vHome="clr-namespace:Envz.UI.Views.Pages.Home"
  xmlns:vmHome="clr-namespace:Envz.UI.ViewModels.Pages.Home"
  xmlns:vSettings="clr-namespace:Envz.UI.Views.Pages.Settings"
  xmlns:vmSettings="clr-namespace:Envz.UI.ViewModels.Pages.Settings"
  xmlns:vm="clr-namespace:Envz.UI.ViewModels"
  xmlns:controls="clr-namespace:Envz.UI.Views.UserControls.Controls"
  mc:Ignorable="d" 
  d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
  Title="MainWindow" 
  Width="{StaticResource AppWidth}" 
  Height="{StaticResource AppHeight}" 
  ResizeMode="NoResize"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <vHome:HomePage x:Key="HomePageInstance" />
    <vEnvironments:HomeEnvironmentsPage x:Key="HomeEnvironmentsPageInstance" />
    <vEnvironments:CreateEnvironmentPage x:Key="CreateEnvironmentPageInstance" />
    <vEnvironments:EditEnvironmentPage x:Key="EditEnvironmentPageInstance" />
    <vApplications:HomeApplicationsPage x:Key="HomeApplicationsPageInstance" />
    <vApplications:AddApplicationPage x:Key="AddApplicationPageInstance" />
    <vSettings:SettingsPage x:Key="SettingsPageInstance" />

    <DataTemplate DataType="{x:Type vmHome:HomePageViewModel}">
      <ContentPresenter Content="{StaticResource HomePageInstance}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmEnvironments:HomeEnvironmentsPageViewModel}">
      <ContentPresenter Content="{StaticResource HomeEnvironmentsPageInstance}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmEnvironments:EditEnvironmentPageViewModel}">
      <ContentPresenter Content="{StaticResource EditEnvironmentPageInstance}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmEnvironments:CreateEnvironmentPageViewModel}">
      <ContentPresenter Content="{StaticResource CreateEnvironmentPageInstance}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmApplications:HomeApplicationsPageViewModel}">
      <ContentPresenter Content="{StaticResource HomeApplicationsPageInstance}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmApplications:AddApplicationPageViewModel}">
      <ContentPresenter Content="{StaticResource AddApplicationPageInstance}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmSettings:SettingsPageViewModel}">
      <ContentPresenter Content="{StaticResource SettingsPageInstance}" />
    </DataTemplate>
  </Window.Resources>

  <Border Background="{StaticResource BgPrimaryBrush}" 
          BorderBrush="{StaticResource NeutralBrush}" 
          BorderThickness="2" 
          CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect Color="#000000" 
                        BlurRadius="15" 
                        ShadowDepth="2" 
                        Opacity="0.25" 
                        Direction="270" />
    </Border.Effect>

    <Grid>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0"
              Height="{StaticResource TitleBarHeight}"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown" 
              Background="{StaticResource SidebarBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" 
                     Margin="10 5 0 0" 
                     Style="{StaticResource TextH1}" 
                     Text="Envz" />

          <Grid Grid.Column="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Style="{StaticResource TitleBarButton}" 
                    Click="MinimizeButtonClick">
              <Image Margin="0, 10, 0, 0" 
                     Source="{StaticResource IconUnderscoreBlack}" 
                     Width="16" Height="16" />
            </Button>

            <Button Grid.Column="1" 
                    Style="{StaticResource TitleBarButton}" 
                    Click="CloseButtonClick">
              <Image Source="{StaticResource IconCrossBlack}" 
                     Width="16" Height="16" />
            </Button>
          </Grid>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Sidebar -->
          <StackPanel Grid.Column="0" 
                      Width="{StaticResource SideBarWidth}"
                      Background="{StaticResource SidebarBrush}">
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="Home" 
                         Command="{Binding ShowHomePageCommand}" 
                         IsChecked="True" />
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="Environments" 
                         Command="{Binding ShowEnvironmentsPageCommand}" />
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="Applications" 
                         Command="{Binding ShowApplicationsPageCommand}" />
            <RadioButton Style="{StaticResource NavigationButton}" 
                         Content="Settings" 
                         Command="{Binding ShowSettingsPageCommand}" />
          </StackPanel>

          <!-- Main content -->
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:Breadcrumb Grid.Row="0" 
                                 Items="{Binding BreadcrumbItems}" />
            <ContentControl Grid.Row="1" 
                            Content="{Binding CurrentViewModel}" />
          </Grid>
        </Grid>
      </Grid>

      <Border Background="#80000000" 
              Panel.ZIndex="10" 
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}" 
              d:Visibility="Collapsed" />
    </Grid>
  </Border>

</Window>