<UserControl
  x:Class="Envz.UI.Views.Pages.Tools.AddTool.AddToolPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  xmlns:sai="clr-namespace:Envz.UI.Views.UserControls.SelectableToolItem"
  xmlns:aa="clr-namespace:Envz.UI.Views.Pages.Tools.AddTool"
  xmlns:utils="clr-namespace:Envz.Common.UI.Utils;assembly=Envz.Common"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=aa:AddToolPageViewModel}"
  Style="{StaticResource PageStyle}">

  <Grid Margin="30 10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ctrls:SearchBox Grid.Column="0"
                       Text="{Binding SearchableTools.SearchText}"
                       Placeholder="{loc:Translate Global_SearchTool}" />

      <ctrls:ButtonText Grid.Column="1"
                        Text="{loc:Translate Global_Browse}"
                        Command="{Binding BrowseCommand}"
                        Width="110"
                        Height="{StaticResource TextInputHeight}"
                        Margin="10 0 0 0" />
    </Grid>

    <Grid Grid.Row="1" Margin="0 10 0 0">
      <ScrollViewer Style="{StaticResource PrimaryScrollViewer}">
        <ItemsControl ItemsSource="{Binding SearchableTools.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <sai:SelectableToolItem Height="{StaticResource ToolListItemHeight}"
                                             Margin="0 0 0 5" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{loc:Translate AddTool_Detecting}"
                 Style="{StaticResource TextBody}"
                 Foreground="{StaticResource ForegroundMutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 utils:Show.If="{Binding IsLoading}"
                 d:Visibility="Hidden" />

      <TextBlock Text="{loc:Translate AddTool_NoneDetected}"
                 Style="{StaticResource TextBody}"
                 Foreground="{StaticResource ForegroundMutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 utils:Show.If="{Binding ShowNoneDetected}"
                 d:Visibility="Hidden" />

      <TextBlock Text="{loc:Translate AddTool_NoResult}"
                 Style="{StaticResource TextBody}"
                 Foreground="{StaticResource ForegroundMutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 utils:Show.If="{Binding SearchableTools.HasNoMatch}"
                 d:Visibility="Hidden" />
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
      <ctrls:ButtonText Text="{loc:Translate Global_Cancel}"
                        ButtonStyle="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Width="150" Height="35"
                        Margin="0 0 20 0" />
      <ctrls:ButtonText Text="{Binding AddButtonText}"
                        Command="{Binding AddSelectedCommand}"
                        Width="150" Height="35" />
    </StackPanel>
  </Grid>

</UserControl>