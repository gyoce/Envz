<UserControl 
  x:Class="Envz.UI.Views.Pages.Applications.HomeApplications.HomeApplicationsPage" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:ai="clr-namespace:Envz.UI.Views.UserControls.ApplicationItem"
  xmlns:ha="clr-namespace:Envz.UI.Views.Pages.Applications.HomeApplications"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d" 
  d:DataContext="{d:DesignInstance Type=ha:HomeApplicationsPageViewModel}"
  Style="{StaticResource PageStyle}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="30 10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ctrls:SearchBox Grid.Column="0"
                       Text="{Binding SearchableApplications.SearchText}"
                       Placeholder="{loc:Translate Global_SearchApplication}"/>

      <ctrls:ButtonImage Grid.Column="1" 
                         Source="{StaticResource IconAddWhite}" 
                         Command="{Binding AddApplicationCommand}" 
                         ImageWidth="20" ImageHeight="20" 
                         Margin="10 0 0 0" />
    </Grid>

    <ScrollViewer Grid.Row="1" Style="{StaticResource PrimaryScrollViewer}" Margin="30 0">
      <ItemsControl ItemsSource="{Binding SearchableApplications.Items}" d:ItemsSource="{d:SampleData ItemCount=5}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" Margin="-10 0" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ai:ApplicationItem DataContext="{Binding}" 
                                Margin="10 5 10 5" 
                                Width="{StaticResource ApplicationListItemWidth}" 
                                Height="{StaticResource ApplicationListItemHeight}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>

</UserControl>