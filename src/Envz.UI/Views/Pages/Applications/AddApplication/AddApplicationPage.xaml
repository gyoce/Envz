<UserControl
  x:Class="Envz.UI.Views.Pages.Applications.AddApplication.AddApplicationPage"
  mc:Ignorable="d"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ctrls="clr-namespace:Envz.UI.Views.UserControls.Controls"
  xmlns:aa="clr-namespace:Envz.UI.Views.Pages.Applications.AddApplication"
  d:DataContext="{d:DesignInstance Type=aa:AddApplicationPageViewModel}"
  Width="{StaticResource SubPageWidth}" 
  Height="{StaticResource SubPageHeight}">

  <Border Background="{StaticResource BgPrimaryBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="30 20">

        <!-- Path -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ctrls:TextInput Grid.Column="0" 
                           Label="Path" 
                           Text="{Binding Request.Path}" 
                           VerticalAlignment="Top"/>
          <ctrls:ButtonText Grid.Column="1" 
                            Text="Browse..." 
                            Command="{Binding BrowseApplicationCommand}" 
                            VerticalAlignment="Bottom" 
                            Width="100" 
                            Height="{StaticResource TextInputHeight}" 
                            Margin="10 0 0 0"/>
        </Grid>

        <!-- Name -->
        <ctrls:TextInput Label="Name" 
                         Text="{Binding Request.Name}" 
                         Margin="0 15 0 0"/>

        <!-- Icon -->
        <StackPanel Orientation="Vertical" Margin="0 20 0 0">
          <TextBlock Text="Icon" 
                     Margin="5 0 0 3" 
                     Style="{StaticResource TextBody}"/>
          <StackPanel Orientation="Horizontal">
            <Border Width="64" Height="64" 
                    Background="{StaticResource BgSecondaryBrush}" 
                    BorderBrush="{StaticResource NeutralBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
              <Image Source="{Binding ApplicationIcon}" 
                     Stretch="Uniform" 
                     Width="60" Height="60"/>
            </Border>
            <ctrls:ButtonText Text="Browse ..." 
                              Command="{Binding BrowseIconCommand}" 
                              VerticalAlignment="Bottom" 
                              Width="100" 
                              Height="{StaticResource TextInputHeight}" 
                              Margin="10 0 0 0"/>
          </StackPanel>
        </StackPanel>

      </StackPanel>

      <!-- Bottom buttons -->
      <StackPanel Grid.Row="1" 
                  Orientation="Horizontal" 
                  HorizontalAlignment="Center" 
                  Margin="0 0 0 20">
        <ctrls:ButtonText Text="Cancel" 
                          ButtonStyle="{StaticResource SecondaryButton}" 
                          Command="{Binding CancelAddApplicationCommand}" 
                          Width="150" Height="35" 
                          Margin="0 0 20 0"/>
        <ctrls:ButtonText Text="Add" 
                          Command="{Binding AddApplicationCommand}" 
                          Width="150" Height="35"/>
      </StackPanel>
    </Grid>
  </Border>

</UserControl>