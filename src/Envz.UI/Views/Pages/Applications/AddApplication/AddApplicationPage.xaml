<UserControl
  x:Class="Envz.UI.Views.Pages.Applications.AddApplication.AddApplicationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:aa="clr-namespace:Envz.UI.Views.Pages.Applications.AddApplication"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=aa:AddApplicationPageViewModel}"
  Style="{StaticResource PageStyle}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="30 20">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ctrls:TextInput Grid.Column="0" 
                         Label="{loc:Translate Global_Path}" 
                         Text="{Binding Request.Path}" 
                         VerticalAlignment="Top"/>
        <ctrls:ButtonText Grid.Column="1" 
                        Text="{loc:Translate Global_Browse}" 
                        Command="{Binding BrowseApplicationCommand}" 
                        VerticalAlignment="Bottom" 
                        Width="100" 
                        Height="{StaticResource TextInputHeight}" 
                        Margin="10 0 0 0"/>
      </Grid>

      <ctrls:TextInput Label="{loc:Translate Global_Name}" 
                       Text="{Binding Request.Name}" 
                       Margin="0 15 0 0"/>

      <StackPanel Orientation="Vertical" Margin="0 20 0 0">
        <TextBlock Text="{loc:Translate Global_Icon}" 
                   Margin="5 0 0 3" 
                   Style="{StaticResource TextBody}"/>
        <StackPanel Orientation="Horizontal">
          <Border Width="64" Height="64" 
                  Background="{StaticResource BgSecondaryBrush}" 
                  BorderBrush="{StaticResource NeutralBrush}" 
                  BorderThickness="1" 
                  CornerRadius="4">
            <Image Source="{Binding ApplicationIcon}" 
                   Stretch="Uniform" 
                   Width="60" Height="60"/>
          </Border>
          <ctrls:ButtonText Text="{loc:Translate Global_Browse}" 
                            Command="{Binding BrowseIconCommand}" 
                            VerticalAlignment="Bottom" 
                            Width="100" 
                            Height="{StaticResource TextInputHeight}" 
                            Margin="10 0 0 0"/>
        </StackPanel>
      </StackPanel>

    </StackPanel>

    <StackPanel Grid.Row="1" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                Margin="0 0 0 20">
      <ctrls:ButtonText Text="{loc:Translate Global_Cancel}" 
                        ButtonStyle="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelAddApplicationCommand}" 
                        Width="150" Height="35" 
                        Margin="0 0 20 0"/>
      <ctrls:ButtonText Text="{loc:Translate Global_Add}" 
                        Command="{Binding AddApplicationCommand}" 
                        Width="150" Height="35"/>
    </StackPanel>
  </Grid>

</UserControl>