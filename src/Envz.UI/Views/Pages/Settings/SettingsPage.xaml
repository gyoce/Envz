<UserControl 
  x:Class="Envz.UI.Views.Pages.Settings.SettingsPage" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:st="clr-namespace:Envz.UI.Views.Pages.Settings"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d" 
  d:DataContext="{d:DesignInstance Type=st:SettingsPageViewModel}"
  Style="{StaticResource PageStyle}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ctrls:SelectInput Grid.Row="0" 
                       Label="{loc:Translate Global_Language}" 
                       HorizontalAlignment="Left"
                       Width="300"
                       Margin="30 10 0 0" 
                       ItemsSource="{Binding Languages}"
                       SelectedItem="{Binding SelectedLanguage}"
                       DisplayMemberPath="DisplayName" />
  </Grid>

</UserControl>