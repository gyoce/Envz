<UserControl 
  x:Class="Envz.UI.Views.Pages.Workspaces.SelectTool.SelectToolPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:ai="clr-namespace:Envz.UI.Views.UserControls.ToolItem"
  xmlns:sa="clr-namespace:Envz.UI.Views.Pages.Workspaces.SelectTool"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d" 
  d:DataContext="{d:DesignInstance Type=sa:SelectToolPageViewModel}"
  Style="{StaticResource PageStyle}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="20 10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <ctrls:SearchBox Grid.Row="0" 
                       Text="{Binding SearchableTools.SearchText}"
                       Placeholder="{loc:Translate Global_SearchTool}" />

      <ListBox Grid.Row="1" 
               ItemsSource="{Binding SearchableTools.Items}" 
               SelectedItem="{Binding SelectedTool}" 
               ItemContainerStyle="{StaticResource ToolListBoxItemStyle}" 
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
               Background="Transparent" 
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ai:ToolItem DataContext="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Grid.Row="1" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                Margin="0 0 0 20">
      <ctrls:ButtonText Text="{loc:Translate Global_Cancel}" 
                        ButtonStyle="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelCommand}" 
                        Width="150" Height="35" 
                        Margin="0 0 20 0" />
      <ctrls:ButtonText Text="{loc:Translate Global_Select}" 
                        Command="{Binding SelectToolCommand}" 
                        Width="150" Height="35" />
    </StackPanel>
  </Grid>

</UserControl>
