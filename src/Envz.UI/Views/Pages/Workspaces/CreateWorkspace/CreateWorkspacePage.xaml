<UserControl
  x:Class="Envz.UI.Views.Pages.Workspaces.CreateWorkspace.CreateWorkspacePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls;assembly=Envz.Common"
  xmlns:eai="clr-namespace:Envz.UI.Views.UserControls.WorkspaceToolItem"
  xmlns:ce="clr-namespace:Envz.UI.Views.Pages.Workspaces.CreateWorkspace"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc;assembly=Envz.Common"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=ce:CreateWorkspacePageViewModel}"
  Style="{StaticResource PageStyle}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ctrls:TextInput Grid.Row="0" 
                       Label="{loc:Translate Global_Name}" 
                       Text="{Binding CreateWorkspaceRequest.Name}" 
                       Margin="30 10 0 10" 
                       Width="400" 
                       HorizontalAlignment="Left" />

      <StackPanel Grid.Row="1" Orientation="Vertical" Margin="30 10 30 0">
        <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
          <TextBlock Text="{loc:Translate Global_Tools}" 
                     Margin="5 0 0 0" 
                     Style="{StaticResource TextBody}" 
                     VerticalAlignment="Center" />
          <ctrls:ButtonImage Source="{StaticResource IconAddWhite}" 
                             Command="{Binding AddToolCommand}" 
                             Margin="10 0 0 0" 
                             ImageWidth="10" ImageHeight="14"/>
        </StackPanel>
        <ScrollViewer Style="{StaticResource PrimaryScrollViewer}">
          <Grid>
            <TextBlock Text="{loc:Translate CreateWorkspace_NoTools}" 
                       Margin="5 10 0 0" 
                       Foreground="{StaticResource ForegroundMutedBrush}" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTools}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding ToolViewModels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <eai:WorkspaceToolItem DataContext="{Binding}" 
                                                  Margin="0 0 0 5"
                                                  Width="{StaticResource WorkspaceToolListItemWidth}"
                                                  Height="{StaticResource WorkspaceToolListItemHeight}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 20">
      <ctrls:ButtonText Text="{loc:Translate Global_Cancel}" 
                        ButtonStyle="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelCreateWorkspaceCommand}" 
                        Width="150" Height="35" Margin="0 0 20 0" />
      <ctrls:ButtonText Text="{loc:Translate Global_Create}" 
                        Command="{Binding CreateWorkspaceCommand}" 
                        Width="150" Height="35" />
    </StackPanel>
  </Grid>

</UserControl>
