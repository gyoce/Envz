<Application 
  x:Class="Envz.UI.App" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:utils="clr-namespace:Envz.UI.Utils">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Colors.xaml" />
        <ResourceDictionary Source="Styles/Buttons.xaml" />
        <ResourceDictionary Source="Styles/Texts.xaml" />
        <ResourceDictionary Source="Styles/Icons.xaml" />
        <ResourceDictionary Source="Styles/Scrollbar.xaml" />
        <ResourceDictionary Source="Styles/Inputs.xaml" />
        <ResourceDictionary Source="Styles/Sizes.xaml" />
        <ResourceDictionary Source="Styles/ListBox.xaml" />
        <ResourceDictionary Source="Styles/Borders.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>

</Application>