<Application 
  x:Class="Envz.UI.App" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:utils="clr-namespace:Envz.Common.UI.Utils;assembly=Envz.Common">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Colors.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Buttons.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Texts.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Icons.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Scrollbar.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Inputs.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Sizes.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/ListBox.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Borders.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/Views.xaml" />
        <ResourceDictionary Source="/Envz.Common;component/UI/Styles/ComboBox.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>

</Application>