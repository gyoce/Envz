<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="ApplicationBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NeutralFocusBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DialogFooterBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="0 0 4 4" />
    <Setter Property="Padding" Value="24 12" />
  </Style>

</ResourceDictionary>
