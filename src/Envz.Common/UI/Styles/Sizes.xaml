<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:Double x:Key="AppWidth">1280</sys:Double>
  <sys:Double x:Key="AppHeight">540</sys:Double>

  <sys:Double x:Key="DialogWidth">720</sys:Double>
  <sys:Double x:Key="DialogHeight">260</sys:Double>

  <sys:Double x:Key="PageWidth">1090</sys:Double> <!-- SubPageWidth = PageWidth -->
  <sys:Double x:Key="PageHeight">450</sys:Double> <!-- SubPageHeight = PageHeight - BreadcrumbHeight -->

  <sys:Double x:Key="DialogPageWidth">720</sys:Double> <!-- DialogPageWidth = DialogWidth -->
  <sys:Double x:Key="DialogPageHeight">220</sys:Double><!-- DialogPageHeight = DialogHeight - DialogTitleBarHeight -->

  <sys:Double x:Key="TitleBarHeight">50</sys:Double>
  <sys:Double x:Key="DialogTitleBarHeight">40</sys:Double>

  <sys:Double x:Key="SideBarWidth">190</sys:Double>

  <sys:Double x:Key="BreadcrumbHeight">40</sys:Double>
  <sys:Double x:Key="BreadcrumbWidth">1090</sys:Double>

  <sys:Double x:Key="WorkspaceListItemWidth">330</sys:Double>
  <sys:Double x:Key="WorkspaceListItemHeight">170</sys:Double>

  <sys:Double x:Key="ToolListItemWidth">1030</sys:Double>
  <sys:Double x:Key="ToolListItemHeight">50</sys:Double>

  <sys:Double x:Key="DialogToolListItemWidth">920</sys:Double>
  <sys:Double x:Key="DialogToolListItemHeight">50</sys:Double>

  <sys:Double x:Key="WorkspaceToolListItemWidth">1030</sys:Double>
  <sys:Double x:Key="WorkspaceToolListItemHeight">50</sys:Double>

  <sys:Double x:Key="TextInputHeight">35</sys:Double>

</ResourceDictionary>