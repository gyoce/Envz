<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="PageStyle" TargetType="UserControl">
    <Setter Property="Width" Value="{StaticResource PageWidth}" />
    <Setter Property="Height" Value="{StaticResource PageHeight}" />
    <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}" />
  </Style>

  <Style x:Key="DialogStyle" TargetType="UserControl">
    <Setter Property="Width" Value="{StaticResource DialogPageWidth}" />
    <Setter Property="Height" Value="{StaticResource DialogPageHeight}" />
    <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}" />
  </Style>

</ResourceDictionary>