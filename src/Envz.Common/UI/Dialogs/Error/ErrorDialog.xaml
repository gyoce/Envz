<UserControl 
  x:Class="Envz.Common.UI.Dialogs.Error.ErrorDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ctrls="clr-namespace:Envz.Common.UI.Controls"
  xmlns:error="clr-namespace:Envz.Common.UI.Dialogs.Error"
  xmlns:loc="clr-namespace:Envz.Common.UI.Loc"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=error:ErrorDialogViewModel}"
  Style="{StaticResource DialogStyle}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" 
               Margin="24 16 24 24" 
               Style="{StaticResource TextBody}" 
               Text="{Binding Message, FallbackValue=Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.}" 
               TextWrapping="Wrap" />

    <ctrls:ButtonText Width="100"
                      Grid.Row="1" 
                      HorizontalAlignment="Center" 
                      Text="{loc:Translate Global_Ok}" 
                      Command="{Binding CloseCommand}" 
                      Margin="0 0 0 10"/>
  </Grid>

</UserControl>