<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="PrimaryBackgroundColor">#F8F9FA</Color>
  <Color x:Key="SecondaryBackgroundColor">#F1F2F3</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>

  <Color x:Key="PrimaryColor">#4A5568</Color>
  <Color x:Key="PrimaryHoverColor">#3D4A5C</Color>
  <Color x:Key="PrimaryPressedColor">#2D3748</Color>
  <Color x:Key="PrimaryFocusedColor">#4A5568</Color>
  <Color x:Key="PrimaryActiveColor">#667EEA</Color>

  <Color x:Key="SecondaryColor">#A0AEC0</Color>
  <Color x:Key="SecondaryHoverColor">#8A96A8</Color>
  <Color x:Key="SecondaryPressedColor">#718096</Color>

  <Color x:Key="DisabledColor">#E2E8F0</Color>
  <Color x:Key="DisabledForegroundColor">#A0AEC0</Color>

  <Color x:Key="ForegroundColor">#2D3748</Color>

  <Color x:Key="SidebarColor">#ECEEF2</Color>

  <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
  <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
  <SolidColorBrush x:Key="PrimaryFocusedBrush" Color="{StaticResource PrimaryFocusedColor}"/>
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
  <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHoverColor}"/>
  <SolidColorBrush x:Key="SecondaryPressedBrush" Color="{StaticResource SecondaryPressedColor}"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
  <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}"/>
  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActiveColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
</ResourceDictionary>