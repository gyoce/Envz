<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BgPrimaryColor">#F7F8FA</Color>
  <Color x:Key="BgSecondaryColor">#F0F2F5</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SidebarColor">#ECEEF3</Color>

  <Color x:Key="AccentColor">#5A67D8</Color>
  <Color x:Key="AccentHoverColor">#4C56C0</Color>
  <Color x:Key="AccentPressedColor">#3D459B</Color>
  <Color x:Key="AccentFocusColor">#7F8FE8</Color>

  <Color x:Key="PrimaryColor">#5E6B7E</Color>
  <Color x:Key="PrimaryHoverColor">#4E5B6E</Color>
  <Color x:Key="PrimaryPressedColor">#3E4B5E</Color>
  <Color x:Key="PrimaryFocusColor">#6E7B8E</Color>

  <Color x:Key="NeutralColor">#64748B</Color>
  <Color x:Key="NeutralHoverColor">#536071</Color>
  <Color x:Key="NeutralPressedColor">#3E4D5E</Color>
  <Color x:Key="NeutralFocusColor">#94A3B8</Color>

  <Color x:Key="ForegroundColor">#1E293B</Color>
  <Color x:Key="ForegroundMutedColor">#64748B</Color>

  <Color x:Key="DisabledColor">#7B8A9A</Color>
  <Color x:Key="DisabledForegroundColor">#FFFFFF</Color>

  <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
  <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentFocusBrush" Color="{StaticResource AccentFocusColor}" />

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
  <SolidColorBrush x:Key="PrimaryFocusBrush" Color="{StaticResource PrimaryFocusColor}" />

  <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}" />
  <SolidColorBrush x:Key="NeutralHoverBrush" Color="{StaticResource NeutralHoverColor}" />
  <SolidColorBrush x:Key="NeutralPressedBrush" Color="{StaticResource NeutralPressedColor}" />
  <SolidColorBrush x:Key="NeutralFocusBrush" Color="{StaticResource NeutralFocusColor}" />

  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource ForegroundMutedColor}" />

  <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />
  <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
</ResourceDictionary>
