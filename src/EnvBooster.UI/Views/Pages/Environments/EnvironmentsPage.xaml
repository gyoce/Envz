<UserControl 
  x:Class="EnvBooster.UI.Views.Pages.Environments.EnvironmentsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:vm="clr-namespace:EnvBooster.UI.ViewModels.Pages.Environments.SubPages"
  xmlns:uc="clr-namespace:EnvBooster.UI.Views.Pages.Environments.SubPages"
  mc:Ignorable="d"
  Width="{StaticResource PageWidth}" Height="{StaticResource PageHeight}">

  <UserControl.Resources>
    <uc:HomeEnvironmentsSubPage x:Key="HomeEnvironmentsSubPageInstance"/>
    <uc:EditEnvironmentSubPage x:Key="EditEnvironmentSubPageInstance"/>
    <uc:CreateEnvironmentSubPage x:Key="CreateEnvironmentSubPageInstance"/>

    <DataTemplate DataType="{x:Type vm:HomeEnvironmentsSubPageViewModel}">
      <ContentPresenter Content="{StaticResource HomeEnvironmentsSubPageInstance}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditEnvironmentSubPageViewModel}">
      <ContentPresenter Content="{StaticResource EditEnvironmentSubPageInstance}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CreateEnvironmentSubPageViewModel}">
      <ContentPresenter Content="{StaticResource CreateEnvironmentSubPageInstance}"/>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Page title -->
      <TextBlock Grid.Row="0" Text="Environments" Style="{StaticResource H2}" HorizontalAlignment="Center"/>

      <ContentControl Grid.Row="1" Content="{Binding CurrentSubViewModel}"/>
    </Grid>
  </Border>

</UserControl>