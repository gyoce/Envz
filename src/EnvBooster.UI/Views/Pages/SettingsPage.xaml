<UserControl 
  x:Class="EnvBooster.UI.Views.Pages.SettingsPage" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  mc:Ignorable="d" 
  Width="{StaticResource PageWidth}" 
  Height="{StaticResource PageHeight}">

  <Border Background="{StaticResource BgPrimaryBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource TextH2}" HorizontalAlignment="Center" />
    </Grid>
  </Border>

</UserControl>