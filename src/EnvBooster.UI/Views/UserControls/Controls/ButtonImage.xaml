<UserControl 
  x:Class="EnvBooster.UI.Views.UserControls.Controls.ButtonImage" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  mc:Ignorable="d" 
  x:Name="Root">

  <Button Command="{Binding Command, ElementName=Root}" Style="{Binding ButtonStyle, ElementName=Root, FallbackValue={StaticResource PrimaryButton}}">
    <Image Source="{Binding Source, ElementName=Root, FallbackValue={StaticResource IconAddWhite}}" Width="{Binding ImageWidth, ElementName=Root, FallbackValue=16}" Height="{Binding ImageHeight, ElementName=Root, FallbackValue=16}" Stretch="Uniform" />
  </Button>

</UserControl>