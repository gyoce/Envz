<UserControl 
  x:Class="EnvBooster.UI.Views.UserControls.EnvironmentApplication" 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  mc:Ignorable="d" 
  d:DesignWidth="800" 
  Height="50">

  <Grid VerticalAlignment="Center" Margin="10 0 0 0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Image Grid.Column="0" Width="24" Height="24" Source="{Binding Icon}" />
    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}" Text="{Binding Path, FallbackValue=Path/To/Executable.exe}" />
  </Grid>

</UserControl>